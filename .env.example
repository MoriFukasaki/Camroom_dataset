DOMAIN=cam.example.com
# Neon CLI writes real secrets to .env.local. Do not put them in browser JS.
NEON_BUCKET=assets
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_REALTIME_URL=
NEON_REALTIME_SECRET=
RECORDING_DIR=./data/recordings
MAX_RECORDING_BYTES=2147483648
# Optional: coturn with use-auth-secret and a matching static-auth-secret.
# Use a dedicated TURN domain and allow the TURN service/relay ports on its host.
TURN_URLS=
TURN_SECRET=
# Provider-issued credentials: use these instead of TURN_SECRET, never both.
TURN_USERNAME=
TURN_PASSWORD=
# all = direct + relay fallback; relay = require TURN, useful to verify 4G/5G connectivity.
ICE_TRANSPORT_POLICY=all
# Default: one camera sends a JPEG every 5 seconds; each of 3 cameras updates every 15s.
PREVIEW_MODE=snapshots
# Generate a dedicated random token; never expose it in browser JS.
PROCESSING_WORKER_TOKEN=
PROCESSING_SERVER_URL=http://127.0.0.1:3000
PROCESSING_PYTHON=
# Optional JSON {"lenses":{"1":{"size":[1920,1080],"matrix":[...],"distortion":[...]}}}
PROCESSING_CALIBRATION_FILE=
# Local smoke tests only, never set on production Render.
CAMROOM_LOCAL_MEDIA=0
